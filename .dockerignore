images
# Compile outputs. docker compose mounts the workstation src tree over /src,
# so the build tree stays out of dockerfile/Dockerfile.wireshark-ubi9-build.
# src/artifacts stays in the context. The runtime image copies the RPM from
# src/artifacts/rpms. Delete that RPM before building the compile image when
# it should not be copied into wireshark-ubi9:dev.
src/build
src/wireshark-*/build
