# GitLab job image, tagged
# artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap-docker:9.8.
#
#   docker build --add-host satellite9b.hsv.local:10.10.106.59 \
#     -f dockerfile/Dockerfile.ubi9-tahaa-bootstrap-docker \
#     -t artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap-docker:9.8 .
#
# The base is ubi9-tahaa-bootstrap. This image adds the Docker client and
# the packages a GitLab job needs to check out the repository. The Docker
# engine stays on the runner. Mount /var/run/docker.sock into the job so
# the client uses that engine. The compile and runtime images do not use
# this image as their base.

ARG BOOTSTRAP_IMAGE=artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap:9.8

FROM ${BOOTSTRAP_IMAGE}

# docker-ce-cli is the Docker client. The engine stays on the runner and is
# reached through the mounted socket. install_weak_deps=0 keeps that engine
# out of this image. The distro package named docker stores images under
# /var/lib/containers and mounts them with fuse-overlayfs, which fails when
# /dev/fuse is absent, so this image does not install it.
RUN printf 'assumeyes=1\nmax_parallel_downloads=10\ntsflags=nodocs\ninstall_weak_deps=0\n' >> /etc/dnf/dnf.conf \
    && if [ -e /etc/rhsm-host ]; then rm -rf /etc/rhsm-host; fi \
    && if [ -f /etc/yum.repos.d/ubi.repo ]; then sed -i '/^enabled=/a priority=1' /etc/yum.repos.d/ubi.repo; fi \
    && dnf -y install ca-certificates git gzip tar docker-ce-cli \
    && command -v docker \
    && docker --version | grep -q '^Docker version ' \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && ln -sfn /run/secrets/rhsm /etc/rhsm-host

CMD ["bash"]
