# GitLab job image, tagged
# artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap-docker:9.8.
#
#   docker build --add-host satellite9b.hsv.local:10.10.106.59 \
#     -f dockerfile/Dockerfile.ubi9-tahaa-bootstrap-docker \
#     -t artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap-docker:9.8 .
#
# The base is ubi9-tahaa-bootstrap. This image adds the Docker client,
# dockerd, and the packages a GitLab job needs to check out the repository.
# Job containers use the client. A privileged Deployment runs dockerd from
# this same image; see k8s/wireshark-docker.yaml. The image command stays
# bash, so a job does not start the engine. The compile and runtime images
# do not use this image as their base.
#
# The distro package named docker stores images under /var/lib/containers
# and mounts them with fuse-overlayfs. This image does not install that
# package. Satellite has to provide docker-ce, docker-ce-cli, and containerd.io.

ARG BOOTSTRAP_IMAGE=artifactory.tahaa.local/tahaa-image-local/ubi9/ubi9-tahaa-bootstrap:9.8

FROM ${BOOTSTRAP_IMAGE}

# install_weak_deps=0 skips recommended packages. docker-ce, docker-ce-cli,
# and containerd.io are named so the client and dockerd are both present.
RUN printf 'assumeyes=1\nmax_parallel_downloads=10\ntsflags=nodocs\ninstall_weak_deps=0\n' >> /etc/dnf/dnf.conf \
    && if [ -e /etc/rhsm-host ]; then rm -rf /etc/rhsm-host; fi \
    && if [ -f /etc/yum.repos.d/ubi.repo ]; then sed -i '/^enabled=/a priority=1' /etc/yum.repos.d/ubi.repo; fi \
    && dnf -y install \
        ca-certificates \
        git \
        gzip \
        tar \
        docker-ce \
        docker-ce-cli \
        containerd.io \
    && command -v docker \
    && command -v dockerd \
    && command -v containerd \
    && docker --version | grep -q '^Docker version ' \
    && dockerd --version \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && ln -sfn /run/secrets/rhsm /etc/rhsm-host

CMD ["bash"]
