# Compile image, tagged wireshark-ubi9:dev.
#
#   podman build -f dockerfile/Dockerfile.wireshark-ubi9 -t wireshark-ubi9:dev .
#
# The base is the TAHAA UBI 9.8 bootstrap. It already carries the
# isolated-network certificates, yum repositories, and hosts file. The rhsm
# and ubi.repo steps run only when those files exist, so a Podman build on a
# Satellite host can still use the host entitlement.
#
# This file builds the compiler image only. The image that runs the Wireshark
# GUI is dockerfile/Dockerfile.wireshark-runtime. Build that one after
# src/scripts/build-rpm.sh has written the RPM.
#
# No DISPLAY is set. Compiling does not open a window.
# /src/scripts/compile-wireshark.sh runs "wireshark --version" with
# QT_QPA_PLATFORM=offscreen. RHEL 9 ships Qt 5.15, not Qt 6, and it does not
# ship libsmi-devel, nghttp3, spandsp, iLBC, bcg729, or opencore-amr.

ARG BOOTSTRAP_IMAGE=artifactory.tahaa.local/tahaa-image-local/ubi9-tahaa-bootstrap:9.8

FROM ${BOOTSTRAP_IMAGE}

RUN printf 'assumeyes=1\nmax_parallel_downloads=10\ntsflags=nodocs\ninstall_weak_deps=0\n' >> /etc/dnf/dnf.conf \
    && if [ -e /etc/rhsm-host ]; then rm -rf /etc/rhsm-host; fi \
    && if [ -f /etc/yum.repos.d/ubi.repo ]; then sed -i '/^enabled=/a priority=1' /etc/yum.repos.d/ubi.repo; fi \
    && bash -c 'set -euo pipefail; \
        repos=(); \
        for repo in ubi-9-codeready-builder-rpms "codeready-builder-for-rhel-9-$(uname -m)-rpms"; do \
          if dnf repolist --all | awk "{print \$1}" | grep -qx "$repo"; then \
            repos+=("--enablerepo=${repo}"); \
          fi; \
        done; \
        echo "CodeReady Builder repos: ${repos[*]:-none}"; \
        dnf -y install "${repos[@]}" \
          ca-certificates \
          cmake \
          curl-minimal \
          diffutils \
          gcc \
          gcc-c++ \
          git \
          gzip \
          m4 \
          make \
          ninja-build \
          rpm-build \
          pkgconf-pkg-config \
          python3 \
          tar \
          which \
          xz \
          flex \
          perl \
          perl-Parse-Yapp \
          gettext-devel \
          desktop-file-utils \
          glib2-devel \
          libgcrypt-devel \
          c-ares-devel \
          pcre2-devel \
          libxml2-devel \
          speexdsp-devel \
          qt5-qtbase-devel \
          qt5-qttools-devel \
          qt5-qtmultimedia-devel \
          qt5-linguist \
          qt5-qtsvg-devel \
          qt5-qtimageformats \
          libxkbcommon-devel \
          libpcap-devel \
          zlib-devel \
          lz4-devel \
          libzstd-devel \
          brotli-devel \
          libnghttp2-devel \
          krb5-devel \
          libcap \
          libcap-devel \
          libssh-devel \
          systemd-devel \
          lua-devel \
          gnutls-devel \
          snappy-devel \
          xxhash-devel \
          libmaxminddb-devel \
          libnl3-devel \
          opus-devel \
          sbc-devel \
          libxslt \
          docbook-style-xsl \
          xdg-utils \
          hicolor-icon-theme; \
        dnf clean all; \
        rm -rf /var/cache/dnf' \
    && ln -sfn /run/secrets/rhsm /etc/rhsm-host

# Version configuration used by src/scripts/compile-wireshark.sh.
COPY versions/ /opt/wireshark-build/versions/

# Wireshark sources, src/scripts, and src/plugins. The source directory name
# follows WIRESHARK_VERSION from versions/RHEL9.env.
COPY src/ /src/

WORKDIR /src
CMD ["bash"]
