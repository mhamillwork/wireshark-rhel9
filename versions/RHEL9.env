# Single source of truth for the RHEL 9 Wireshark package.
# Changing these values changes source lookup, RPM metadata, and image tags.

WIRESHARK_VERSION=4.6.9
PACKET_PENGUIN_VERSION=1.0.5
RHEL_VERSION=9
RPM_PACKAGE_RELEASE=1

# Registry defaults. GitLab CI/CD variables of the same name override these.
# Credentials are never stored here.
ARTIFACTORY_REGISTRY=artifactory.tahaa.local
ARTIFACTORY_REPOSITORY=tahaa-image-local
IMAGE_NAME=wireshark
SUPPORTED=1
