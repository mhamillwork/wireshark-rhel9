# Single source of truth for the Windows 11 Wireshark package.
# Changing these values changes source lookup, the installer name, and Qt.
# GitLab CI does not read this file. Windows builds run on a Windows host.

WIRESHARK_VERSION=4.6.9
PACKET_PENGUIN_VERSION=1.0.5
WINDOWS_VERSION=11
INSTALLER_RELEASE=1

# Qt 6.10.3 is the Windows LTS named by this Wireshark tree.
# aqt installs it at C:\Qt\<QT_VERSION>\msvc2022_64.
QT_VERSION=6.10.3

# ltsc2025 matches Windows 11 24H2 (build 26100) and Windows Server 2025.
# A Windows 11 host on an older build needs a matching base image.
WINDOWS_BUILD_IMAGE=mcr.microsoft.com/windows/servercore:ltsc2025
WINDOWS_RUNTIME_IMAGE=mcr.microsoft.com/windows:ltsc2025

SUPPORTED=1
